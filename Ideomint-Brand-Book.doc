<style>
  body { font-family: 'Segoe UI', Arial, sans-serif; line-height: 1.6; color: #333333; margin: 0; padding: 0; }
  h1 { color: #05070D; font-size: 32px; font-weight: 800; margin-bottom: 10px; }
  h2 { color: #05070D; font-size: 22px; font-weight: 700; margin-top: 40px; margin-bottom: 15px; border-bottom: 1px solid #EEEEEE; padding-bottom: 10px; }
  h3 { color: #FF5A3C; font-size: 16px; font-weight: bold; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 5px; margin-top: 25px; }
  p { margin-top: 0; margin-bottom: 15px; font-size: 14px; }
  ul { margin-top: 0; margin-bottom: 15px; font-size: 14px; }
  table.content-table { width: 100%; border-collapse: collapse; margin-bottom: 25px; margin-top: 10px; }
  table.content-table th, table.content-table td { border: 1px solid #E5E5E5; padding: 12px; text-align: left; font-size: 13px; }
  table.content-table th { background-color: #F8F8F8; color: #05070D; font-weight: bold; }
  .document-title { font-size: 42px; color: #05070D; margin-bottom: 10px; letter-spacing: -1px;}
  .accent-bar { width: 60px; height: 4px; background-color: #FF5A3C; margin-bottom: 30px; }
  .highlight-box { background-color: #F9F9F9; border-left: 4px solid #FF5A3C; padding: 15px 20px; margin: 20px 0; font-size: 14px; color: #555; }
  .hex { font-family: 'Courier New', monospace; background: #EEEEEE; padding: 3px 8px; border-radius: 4px; color: #05070D; font-weight: bold; }
</style>
